# Root is denied by default. Publishing still requires the explicit file manifest.
/*
!/.gitignore
!/PUBLICATION_FILES.txt
!/README.md
!/AGENTS.md
!/SECURITY.md
!/CONTRIBUTING.md
!/pyproject.toml
!/ri.py
!/src/
!/tests/
!/examples/
!/native/
!/tools/
!/docs/
!/admin/
!/broker/

__pycache__/
*.py[cod]
.env
.env.*
*.sqlite*
*.db
*.log
*.ntfs
*.raw
*.img
*.bin
*.zip
*.tar
*.gz
*.pdf
*.html
*.so
*.o
*.exe
*.pem
*.key
*.json
*.jsonl
*.txt
!/PUBLICATION_FILES.txt
!/examples/simulated/windows-usb.json
!/examples/simulated/destination.json
!/examples/ntfs/physical-pin.example.json
!/examples/artifacts/synthetic-note.txt
!/examples/artifacts/benign-readme.txt
!/examples/artifacts/educational-example.txt
